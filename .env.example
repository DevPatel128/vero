# Database (MySQL 8.0+ or PostgreSQL 14+)
DATABASE_URL=postgresql://vero_user:vero_pass@localhost:5432/vero_dev
# DATABASE_URL=mysql://vero_user:vero_pass@localhost:3306/vero_dev

# JWT Signing - RS256 (Required for auth service)
# Generate key pair with:
#   openssl genrsa -out private.pem 2048
#   openssl rsa -in private.pem -pubout -out public.pem
JWT_ALGORITHM=RS256
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# API Configuration
API_PORT=3001
API_HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=debug

# Frontend URLs
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Argon2id Configuration (DPDP Act 2023 compliance)
ARGON2_MEMORY_KB=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=4

# Email (Optional - for OTP verification)
# RESEND_API_KEY=
# or AWS SES
# AWS_SES_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# EMAIL_FROM=noreply@vero.app

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173

