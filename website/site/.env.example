# Vero pre-launch site — env example
# Copy to .env.local for dev. Never commit real secrets.

# Public site URL (used for canonical, OG, sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Waitlist storage: Cloudflare D1 (binding `DB` in wrangler.jsonc), no variable needed.
# In plain `next dev` the site falls back to a local file store (data/waitlist.json).
# To use a local D1 instead, run with CF_DEV_BINDINGS=1 after `npx wrangler d1 migrations apply vero-waitlist --local`.

# Email provider (transactional + waitlist confirmations)
# Leave blank in dev — emails are logged to console instead
RESEND_API_KEY=
WAITLIST_FROM_EMAIL=hello@vero.app

# Investor deck request inbox
INVESTOR_INBOX=investors@vroelabs.com
