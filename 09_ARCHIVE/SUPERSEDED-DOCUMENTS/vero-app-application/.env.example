# ─────────────────────────────────────────────────────────────
# VERO Application — Environment Variables
# Copy this file to .env.local and fill in real values.
# Never commit .env.local. It is in .gitignore.
# ─────────────────────────────────────────────────────────────

# Supabase (https://supabase.com/dashboard)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# JWT signing (RS256 — generate via openssl, see below)
# openssl genpkey -algorithm RSA -out private.pem -pkeyopt rsa_keygen_bits:2048
# openssl rsa -pubout -in private.pem -out public.pem
# Then paste contents with \n for newlines.
JWT_PRIVATE_KEY=""
JWT_PUBLIC_KEY=""

# Razorpay (India payments + escrow)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Upstash Redis (rate limiting)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Resend (transactional email)
RESEND_API_KEY=""
RESEND_FROM_EMAIL="noreply@vero.work"

# PostHog (analytics)
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"

# Sentry (error tracking)
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""
SENTRY_ORG=""
SENTRY_PROJECT="vero-app"

# App URL (used in emails, OAuth callbacks)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
