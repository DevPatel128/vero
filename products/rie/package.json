{
  "name": "rie",
  "version": "1.0.0",
  "private": true,
  "description": "RIE: The Discipline App — A discipline verification platform",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "dev:api": "turbo run dev --filter=@rie/api",
    "dev:website": "turbo run dev --filter=@rie/website",
    "dev:mobile": "turbo run dev --filter=@rie/mobile"
  },
  "devDependencies": {
    "turbo": "^2.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "npm@10.0.0"
}
