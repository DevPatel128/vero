# ─────────────────────────────────────────────────────────
# RIE Environment Variables
# Copy to .env and fill in values
#
# REQUIRED — server will exit(1) at startup if these are missing:
#   DATABASE_URL, REDIS_URL, JWT_PRIVATE_KEY, JWT_PUBLIC_KEY, ENCRYPTION_KEY
#
# OPTIONAL — server will warn at startup but continue:
#   Email (RESEND_API_KEY or AWS SES credentials), Push (FCM_*), Storage (S3_*)
# ─────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────
# REQUIRED
DATABASE_URL="postgresql://rie:rie_dev_2026@localhost:5432/rie?schema=public&connection_limit=10&pool_timeout=30"

# ── Redis ─────────────────────────────────────────────────
# REQUIRED
REDIS_URL="redis://localhost:6379"

# ── Server ───────────────────────────────────────────────
PORT=4000
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:3000

# ── Security ─────────────────────────────────────────────
# REQUIRED — RS256 key pair for JWT signing/verification (PEM format)
JWT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
# REQUIRED — 32-byte hex key for AES-256-GCM field encryption
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

SERVER_SIGNING_KEY=rie-dev-signing-key-change-in-production

# ── Email — pick one provider ─────────────────────────────
# OPTIONAL — Resend (preferred)
RESEND_API_KEY=re_...
EMAIL_FROM=noreply@rie.app
EMAIL_PROVIDER=resend

# OPTIONAL — AWS SES (alternative; set EMAIL_PROVIDER=ses to use)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1

# ── Push Notifications (Firebase Cloud Messaging) ─────────
# OPTIONAL
FCM_PROJECT_ID=rie-app
FCM_SERVER_KEY=

# ── Storage (S3-compatible) ───────────────────────────────
# OPTIONAL
S3_BUCKET=rie-submissions
S3_REGION=us-east-1
S3_ENDPOINT=https://s3.us-east-1.amazonaws.com
S3_ACCESS_KEY=
S3_SECRET_KEY=
